[worldserver]

########################################
# mod-skateboard configuration
########################################
#
# A skateboard, not a mount: the character keeps walking, and the module gives it
# a deck to ride. '.board on' puts a deck under the character, '.board push' kicks
# its speed up, terrain slope and friction fight it back, and the jump button
# becomes the trick button. A boarded deck always rolls - Skateboard.Cruise is
# its floor - and Skateboard.Drive is what moves the character: one knockback
# impulse along the facing every Drive.ImpulseMs, so the rider steers and pushes
# and never has to hold forward to travel. Drive.Mode = 1 is the other carrier: a
# server spline, which follows the hill but only lets the rider steer between
# segments.
#
# Nothing here needs a client patch: the stock deck is the "Log Ride" display
# 26609 that every 3.3.5a client already has. The two plank decks (90001, 90002)
# are world doodad models registered as creature displays, so they only look right
# once the step-4 DBC patch is installed; until then the module warns the first
# time a player boards and uses 26609 instead.
#
# Two ways to draw the board (Skateboard.Deck.Render):
#
#   unit  - the deck is a creature summoned under the rider and walked after them
#           in Skateboard.Deck.FollowMs spline segments. The rider stands on it,
#           and every client draws a creature display. This is the default,
#           because the client draws no mount model for a unit without
#           UNIT_FLAG_MOUNT (playtested: the field alone shows nothing).
#   mount - the older path: Unit::Mount(). The deck is drawn for certain, but
#           the client seats the rider on it and the mount flag makes the core's
#           own UpdateSpeed take the mounted branch. The module re-asserts the
#           rate when it is wiped, so the cap still holds.
#
# The speed cap: while the deck is the mover the character's own run rate is held
# at 1.0, and with Skateboard.Drive = 0 the deck speed is published as a run-speed
# cap instead. Either way the cap only ever lowers the rate: a rider who boards
# while snared, slowed or otherwise below it keeps that effect, and the core
# restores the rate when the aura ends. The cap travels to the client as
# SMSG_FORCE_RUN_SPEED_CHANGE and the core kicks a client that claims a higher
# speed than the server holds, so exactly one change is in flight at a time. The
# gate reopens on the client's ACK, or after Skateboard.AckTimeoutMs if the ACK
# never comes, and the next send waits 100 ms. On a self-hosted realm the RTT is
# 1-5 ms, so the deck still updates many times per second.
#
# Nothing is persisted: the deck lives in memory and is dropped on death,
# logout, a map change, water, flying, a battleground, an arena and (optionally)
# combat.
#

#
#    Skateboard.Enable
#        Master on/off switch. 1 = the board is available: '.board on', the bar
#        and the bindings work, and nobody is boarded until a player asks. 0 =
#        the module loads, '.board' still exists but every refusal says the
#        skateboard is disabled, and nothing updates.
#        The container renderer (scripts/write-confs.sh) overrides this key
#        from SKATEBOARD_ENABLE on every boot, because a container's
#        /opt/acore/etc is part of the image layer and a hand edit is lost at
#        the next rebuild.
#        Default: 1, range: 0/1
#
Skateboard.Enable = 1

#
#    Skateboard.BoardCastMs
#        How long '.board on' takes before the deck appears, in milliseconds. The
#        client draws the bar from the module's own add-on message, and the cast
#        stops when the player steps off the spot, is hit, enters combat, dies or
#        is teleported - nothing is written until it completes, so a stopped cast
#        has nothing to take back. 0 = step on instantly.
#        Default: 2000, range: 0 - 10000
#
Skateboard.BoardCastMs = 2000

#
#    Skateboard.Deck
#        The board to draw. A name, or a raw CreatureDisplayInfo id:
#          plank        = 90001, the Redridge boardwalk plank (default)
#          coffinlid    = 90002, the Duskwood coffin lid
#          log          = 26609, the stock 'Log Ride' (no client patch needed)
#        The two planks are world doodad models registered as creature displays:
#        scripts/skateboard/patch_deck_dbc.py appends those rows to
#        CreatureDisplayInfo.dbc and CreatureModelData.dbc and ships them to the
#        server and the client. A doodad, not a shield: item models are skinned by
#        ItemDisplayInfo at draw time, so one registered as a creature model draws
#        white, and its authored frame is 'held' - it stands on edge instead of
#        lying flat. Without that patch the id is missing from the DBC, so the
#        module warns once at startup and uses 26609 instead. 'engravedwall' is
#        the old name for 90001 and still resolves to it, so a live conf written
#        before the model changed keeps working.
#        Default: plank
#
Skateboard.Deck = plank

#
#    Skateboard.Deck.Render
#        unit = summon a creature that carries Skateboard.Deck's display and
#        follow the rider with it, so the deck is a real object under a standing
#        character. mount = Unit::Mount(), the deck as a mount display: drawn by
#        every client, but the rider sits on it. Changing this takes effect at the
#        next tick: a deck already down is taken away and drawn again in the new
#        shape, so '.reload config' is enough and an active ride is not lost.
#        Default: unit, range: unit|mount
#
Skateboard.Deck.Render = unit

#
#    Skateboard.Deck.Carrier
#        The creature_template row the deck unit is summoned from, in
#        Deck.Render = unit. The carrier's own model never shows - the deck's
#        display is written over it - so what matters is that it is inert: no
#        AIName and no ScriptName, because either gives the deck an AI of its own
#        (16386 looked harmless but carries the Necropolis Relay script, whose
#        constructor marks the creature active). The default, 29443, is a stock
#        display-only prop with neither, so the deck needs no SQL. A row with an
#        AIName or a ScriptName is refused with one log line and no deck.
#        Default: 29443, range: any inert creature_template entry
#
Skateboard.Deck.Carrier = 29443

#
#    Skateboard.Deck.FollowMs
#        Length of one deck-follow segment, in milliseconds. The deck is moved
#        with a spline onto the rider's own path, one segment chained onto the
#        last rather than relaunched over it, and each target is the rider's
#        position projected one segment ahead - and, while the rider is moving,
#        past the half second a client can go between movement packets, because
#        until the next packet lands the server only knows where the rider was.
#        The projection is the carry's own speed while the deck is what moves
#        the rider, and the measured packet-to-packet speed when they are
#        walking. A segment that is still running when the next probe comes
#        round is left to finish: relaunching it mid-path is what made the deck
#        jitter at the rider's heels. Lower costs more spline launches (a probe
#        every quarter of this value), higher smooths the deck but makes it
#        slower to follow a turn.
#        Default: 40, range: 20 - 1000
#
Skateboard.Deck.FollowMs = 40

#
#    Skateboard.MaxSpeed
#        Hard ceiling for the deck, in yd/s. The default is three times the 7.0
#        yd/s base run speed.
#        Default: 21.0, range: 1.0 - 40.0
#
Skateboard.MaxSpeed = 21.0

#
#    Skateboard.Cruise
#        The speed, in yd/s, a boarded deck never drops below while it is
#        rolling. Friction, an uphill and a rider who never pushes can slow the
#        deck to here and no further, so a board that is on is always moving.
#        The backward key (the brake) is the only way to stand still on a deck,
#        and '.board off' is the way off it.
#        Default: 4.0, range: 0.0 - 20.0
#
Skateboard.Cruise = 4.0

#
#    Skateboard.PushImpulse
#        Speed added by one '.board push', in yd/s. One kick per press, never a
#        hold-to-accelerate. 0 makes push a no-op (and reports push=0 in
#        '.board status').
#        Default: 4.0, range: 0.0 - 20.0
#
Skateboard.PushImpulse = 4.0

#
#    Skateboard.Push.Mode
#        0 = one kick per press, the original contract: '.board push' adds
#        PushImpulse once. 1 = hold to pump: the add-on sends '.board push down'
#        on press and '.board push up' on release, and the deck adds one kick
#        every Push.IntervalMs for as long as the hold lasts, so a player can
#        build speed by leaning on the button instead of tapping it.
#        A plain '.board push' still adds exactly one kick in either mode, and
#        Skateboard.Push.MaxHoldMs ends a hold whatever the client does.
#        Default: 0, range: 0|1
#
Skateboard.Push.Mode = 0

#
#    Skateboard.Push.IntervalMs
#        Milliseconds between kicks while a hold is in effect. At the default
#        PushImpulse of 4.0, 500 ms is 8 yd/s^2 of push.
#        Default: 500, range: 100 - 2000
#
Skateboard.Push.IntervalMs = 500

#
#    Skateboard.Push.MaxHoldMs
#        The longest a hold can pump, measured from the down edge. A lost up
#        edge - a logout, a desync, an add-on that stopped running - cannot
#        leave a deck pumping forever. Also what a keyboard or pad press pumps
#        for when the client cannot see the release.
#        Default: 2000, range: 100 - 5000
#
Skateboard.Push.MaxHoldMs = 2000

#
#    Skateboard.Friction.Static
#        Constant deceleration in yd/s^2, applied whether the deck is moving or
#        not. With the default rolling term this bleeds a full-speed deck down
#        in about eight seconds - down to Skateboard.Cruise, never below it: a
#        boarded deck does not stop on its own.
#        Default: 1.5, range: 0.0 - 20.0
#
Skateboard.Friction.Static = 1.5

#
#    Skateboard.Friction.Rolling
#        Quadratic drag: subtracted as this value times v squared, in yd/s^2.
#        Grows with speed, so it mostly matters at the top end.
#        Default: 0.004, range: 0.0 - 1.0
#
Skateboard.Friction.Rolling = 0.004

#
#    Skateboard.SlopeGain
#        Multiplier on the terrain gradient under the character's heading,
#        sampled over 6 yd ahead, and the term that makes hills mean something:
#        at 30.0 a 10% downhill adds 3 yd/s^2 and a 10% uphill takes the same
#        away, so a long slope is felt within a second or two. 0 = the deck does
#        not accelerate from a slope - the carry's arc is still tilted by the
#        gradient, because that is what keeps the rider on the surface rather
#        than what makes the hill fast. Only terrain, never vmaps.
#        Default: 30.0, range: 0.0 - 90.0
#
Skateboard.SlopeGain = 30.0

#
#    Skateboard.Drive
#        The carry, which is what moves a boarded character. A player's movement
#        belongs to the client, so the server cannot simply move a character
#        that is still in control; the one channel the client obeys is its own
#        knockback, so the deck is pushed one impulse along the facing every
#        Drive.ImpulseMs at the deck's current speed. It runs
#        whether or not a movement key is held: forward is not needed to travel
#        (the client's own walk is only extra), backward brakes
#        (Skateboard.Brake), and a rooted or stunned rider is not carried. 0
#        makes the deck a run-speed cap again, which needs the forward key.
#        Default: 1, range: 0|1
#
Skateboard.Drive = 1

#
#    Skateboard.Drive.Mode
#        How the carry moves the rider.
#          0 - knockback kicks: one SMSG_MOVE_KNOCK_BACK impulse per cycle. The
#              rider keeps client control between impulses, so steering is
#              instant, and a jump can start in the gap GroundMs leaves. The arc
#              is tilted by the terrain gradient along the heading, so it lands
#              back on the surface after ArcMs on a hill as well as on the flat:
#              without the tilt a rise cut the arc short (at speed it cut it to
#              nothing - the rider stood still at 0 yd/s) and a drop let it sail.
#              A slope the arc cannot follow, a steep descent at speed, hands the
#              rider a longer flight, and that flight is what the trick window
#              covers.
#          1 - server spline: each segment is a polyline the server samples along
#              the terrain, so the path follows the hill exactly. The core drops
#              the client's own movement while a player's spline is unfinalized
#              (VerifyMovementInfo), so the rider steers *between* segments -
#              Drive.SplineMs is how often that chance comes - and no jump or
#              trick can start during one.
#        Force-restores Skateboard.Drive to 1: the spline is the carrier itself.
#        Default: 0, range: 0|1
#
Skateboard.Drive.Mode = 0

#
#    Skateboard.Drive.ArcMs
#        How long the knockback's arc keeps the rider off their feet, in
#        milliseconds - the vertical half of Drive.Mode = 0. The arc is what makes
#        the impulse carry at all (a zspeed of 0 is a nudge the client drops on
#        the spot), and its height grows with the square of this value: 250 ms is
#        about 0.3 yd, 120 ms about 0.06 yd. The arc is tilted by the gradient, so
#        this is its length on a hill too; a descent too steep for the tilt to
#        follow extends the flight, and the extended flight replaces the window.
#        Shorter reads as a flatter glide and needs a shorter ImpulseMs to stay
#        continuous. 0 derives it from Drive.ImpulseMs - Drive.GroundMs. Nothing
#        inside the arc is a trick: that window is how the module tells the carry
#        from a jump.
#        Default: 0, range: 0 - Drive.ImpulseMs
#
Skateboard.Drive.ArcMs = 0

#
#    Skateboard.Drive.SplineMs
#        Length of one carry segment with Drive.Mode = 1, in milliseconds - also
#        how often the rider gets steering back, because the client's own movement
#        is dropped while a segment runs. 150 is roughly one client movement
#        packet; below 100 the segment restarts faster than the client can report
#        a heading, above 300 a turn arrives late enough to feel like a rail.
#        Default: 150, range: 50 - 1000
#
Skateboard.Drive.SplineMs = 150

#
#    Skateboard.Drive.GroundMs
#        How much of each Drive.ImpulseMs cycle the rider spends standing on the
#        ground, in milliseconds. The impulse is an arc: it takes the rider off
#        their feet for its own duration, and a jump cannot start in mid-air, so
#        without this gap the jump button would do nothing on a deck that is
#        always being carried. The arc keeps its length and covers the whole cycle
#        (so the deck still averages its own speed), which makes the impulse
#        ImpulseMs / (ImpulseMs - GroundMs) times faster than the deck: 1.4x at
#        the defaults. 0 = one continuous glide, and no tricks from a cruising
#        deck.
#        Default: 100, range: 0 - 1000
#
Skateboard.Drive.GroundMs = 100

#
#    Skateboard.Drive.ImpulseMs
#        Milliseconds between carry impulses - one cycle of the carry. Each impulse
#        is an arc sized to ImpulseMs - GroundMs, and the arc's length is the
#        client's, so this is the knob that matches it: too long and the glide
#        stutters, too short and the rider never gets steering back.
#        Default: 350, range: 100 - 2000
#
Skateboard.Drive.ImpulseMs = 350

#
#    Skateboard.Drive.MinSpeed
#        Below this deck speed, in yd/s, the carry stops, so a nearly stopped
#        deck does not crawl its rider forward. It is capped by Skateboard.Cruise:
#        a gate above the floor a boarded deck rolls at would be a deck that boards
#        and never moves.
#        Default: 3.0, range: 0.0 - 40.0
#
Skateboard.Drive.MinSpeed = 3.0

#
#    Skateboard.Brake
#        Extra deceleration while the backward key is held, in yd/s^2, on top of
#        the two friction terms below.
#        Default: 6.0, range: 0.0 - 50.0
#
Skateboard.Brake = 6.0

#
#    Skateboard.LandingBonus
#        Speed added by a clean landing, in yd/s, clamped to MaxSpeed. Independent
#        of Skateboard.Tricks: with tricks off there is no clip to mistime, so
#        every landing is clean and the bonus is the whole of that system.
#        Default: 2.0, range: 0.0 - 20.0
#
Skateboard.LandingBonus = 2.0

#
#    Skateboard.Tricks
#        1 = take-offs queue a clip for the speed band (500/900/1400 ms), play
#        the band's emote and the visual kit, and score the landing: landing
#        before the clip ends crashes the deck, landing at or after it is clean.
#        0 = no automatic clips and no crash from a jump; '.board trick <n>' can
#        still play one by hand.
#        Default: 1, range: 0/1
#
Skateboard.Tricks = 1

#
#    Skateboard.Trick.VisualKit
#        SpellVisualKit id sent on take-off and when a trick is played by hand.
#        0 = no flair.
#        Default: 5036, range: 0 - 100000
#
Skateboard.Trick.VisualKit = 5036

#
#    Skateboard.Trick.List
#        The trick list: `name:emote` entries separated by commas, each with an
#        optional third field for a stock SpellVisualKit id. The name is what
#        the add-on menu shows and what '.board trick <name>' takes; the emote
#        is an Emote.dbc id played on the take-off or on the command.
#        Position is the speed band: entry 1 is the clip queued at slow speed
#        (short), 2 at medium, 3 and beyond at high (long) - so the take-off
#        picks by band, and '.board trick' picks by name.
#        A name is lower-cased and cut to [a-z0-9_-]; an entry with no usable
#        emote is dropped; a list that yields nothing falls back to the shipped
#        three. Up to 8 entries.
#        Default: kickflip:399:5036, ollie:394:5036, grind:388:5036
#
Skateboard.Trick.List = kickflip:399:5036, ollie:394:5036, grind:388:5036

#
#    Skateboard.Crash.Enable
#        1 = a mistimed landing wrecks the deck and hurts, 0 = the character
#        simply steps off.
#        Default: 1, range: 0/1
#
Skateboard.Crash.Enable = 1

#
#    Skateboard.Crash.DamagePct
#        Crash damage as a percentage of maximum health.
#        Default: 8, range: 0 - 99
#
Skateboard.Crash.DamagePct = 8

#
#    Skateboard.Crash.StaggerMs
#        How long the character is rooted after a crash. 0 = no root.
#        Default: 1500, range: 0 - 10000
#        The stagger uses the core's own root state, so a spell root that expires
#        inside the window ends it early: it can be shorter than this, never longer.
#
Skateboard.Crash.StaggerMs = 1500

#
#    Skateboard.HardcoreSafe
#        1 = a crash can never kill: the damage is clamped to leave at least one
#        point of health. 0 = let the fall kill.
#        Default: 1, range: 0/1
#
Skateboard.HardcoreSafe = 1

#
#    Skateboard.OffOnHit
#        1 = being hit by another unit knocks the player off the deck, because a
#        21 yd/s cap is a free disengage. Starting a fight does not: attacking
#        something while riding is allowed, and the deck only goes when something
#        hits back. Fall damage and a crash are not hits. 0 = the deck survives
#        being hit. Boarding while already in combat is refused in either case.
#        Default: 1, range: 0/1
#
Skateboard.OffOnHit = 1

#
#    Skateboard.AckTimeoutMs
#        How long a forced run speed change waits for the client's ACK before
#        the gate is reopened anyway. A lost ACK must never wedge a deck.
#        Default: 500, range: 50 - 5000
#
Skateboard.AckTimeoutMs = 500

#
#    Skateboard.Debug
#        1 = one log line per boarded player every five seconds with the real
#        numbers (v, rate, pending acks, slope), plus the ACK-timeout message at
#        info level instead of as a warning.
#        Default: 0, range: 0/1
#
Skateboard.Debug = 0
