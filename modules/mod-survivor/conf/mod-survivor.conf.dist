[worldserver]

########################################
# mod-survivor configuration
########################################
#
# Opt-in "death is expensive" ruleset: a character flags itself Survivor
# ('.survivor on') and from that point on a death lifts the equipped items and
# everything in the bags off the body and leaves them in a lootable container
# at the place of death. The character is not killed for good - that is
# mod-hardcore's job - and it wakes at the closest graveyard right after the
# death instead of running back as a ghost.
#
# Hardcore and Survivor form a one-way ladder: normal -> Survivor -> Hardcore,
# and normal -> Hardcore. '.survivor on' refuses a character that is flagged
# Hardcore (Hardcore is terminal), while '.hardcore on' accepts a
# Survivor-flagged one and drops the Survivor flag. A Hardcore death still
# leaves a container, but it is a no_mail one and nothing is revived.
#
# Any Survivor-flagged character may open any death container (its own,
# another player's, a bot's, a fallen Hardcore character's); a character that
# never opted in may open none.
#
# The bank, the mail, the gold and the quest log are never touched: the
# ruleset is gear and bags only.
#
# Bot-controlled characters follow the same strip: their gear is left in a
# container where it fell (unless Survivor.BotDropContainer = 0 destroys it) and
# is replaced from playerbots' own factory once they are alive again.
#

#
#    Survivor.Enable
#        Master on/off switch for this module. 0 = the module loads, the
#        '.survivor' command still exists but reports Survivor as disabled,
#        and no death does anything.
#        Default: 1
#
Survivor.Enable = 1

#
#    Survivor.MinLevelToFlag
#        Minimum character level required to run '.survivor on'. Keeps a
#        brand-new character from opting in before it owns anything.
#        Default: 10
#
Survivor.MinLevelToFlag = 10

#
#    Survivor.AnnounceDeaths
#        1 = broadcast a server-wide message when a Survivor character dies
#        and leaves its belongings behind.
#        Default: 1
#
Survivor.AnnounceDeaths = 1

#
#    Survivor.DropEquipped
#        1 = take the equipped items on death. 0 = only the bags are emptied.
#        The equipped bags themselves follow Survivor.DropBags: a bag is only
#        ever destroyed together with its contents, so with DropBags = 0 the
#        equipped bags are kept.
#        Default: 1
#
Survivor.DropEquipped = 1

#
#    Survivor.DropBags
#        1 = take the backpack and everything inside the equipped bags.
#        Default: 1
#
Survivor.DropBags = 1

#
#    Survivor.ContainerLifetimeDays
#        How many days a container stands before its remaining items are
#        mailed back to the owner. A row written with no_mail (a bot container,
#        a Hardcore death's container) is not mailed: its items are deleted
#        instead, because nobody who could use them is coming back. The
#        container also survives a logout and a server restart: it is
#        re-summoned from the database when any Survivor-flagged character
#        enters that map.
#        Default: 7
#
Survivor.ContainerLifetimeDays = 7

#
#    Survivor.MarkOnMap
#        1 = send the SURV addon message ('SURV\tsite ...' / 'SURV\tnone') that
#        draws the death site on the player's world map and minimap. 0 = the
#        containers still work, the addon is just not told about them.
#        Default: 1
#
Survivor.MarkOnMap = 1

#
#    Survivor.ContainerEntry
#        The gameobject template used for the container. 5000000 is the row
#        created by this module's
#        data/sql/world/base/survivor_10_gameobject.sql - a CHEST named
#        "Remains" with lootId 0 (so the hand-filled loot survives) and
#        consumable 1 (so the core deletes it once it is emptied). Do not
#        change this without also supplying a template with the same shape.
#        Default: 5000000
#
Survivor.ContainerEntry = 5000000

#
#    Survivor.ApplyToBots
#        1 = the ruleset also applies to bot-controlled characters: on death
#        their equipment and bags are taken - left in a container, or destroyed
#        when Survivor.BotDropContainer = 0 - and their gear is re-rolled.
#        0 = bots keep their gear.
#        Default: 1
#
Survivor.ApplyToBots = 1

#
#    Survivor.BotRegenOnDeath
#        1 = rebuild a stripped bot's kit (bags plus class/level/spec gear)
#        from playerbots' own factory once it is alive again. 0 = leave it
#        naked until something else gears it.
#        Default: 1
#
Survivor.BotRegenOnDeath = 1

#
#    Survivor.BotDropContainer
#        1 = a bot death also leaves a lootable container where it fell, holding
#        the gear and bags it was carrying. Any Survivor-flagged character may
#        loot it - access belongs to the ruleset, not to the bot: the bot is
#        re-geared by Survivor.BotRegenOnDeath, so the container is not a
#        recovery for the bot but a source of level-appropriate gear for the one
#        real player - the same reason the loot bags exist. A container nobody
#        loots rots at Survivor.ContainerLifetimeDays; its row is written with
#        no_mail, so its items are deleted rather than mailed anywhere.
#        0 = a bot's gear is destroyed outright, leaving nothing behind.
#        Default: 1
#
Survivor.BotDropContainer = 1
