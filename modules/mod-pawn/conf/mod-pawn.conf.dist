[worldserver]

########################################
# mod-pawn configuration
########################################
#
# Pawns: named bots you recruit at any innkeeper, keep in your party, and level
# alongside. The model, the route and the acceptance criteria are in
# docs/PAWN-SYSTEM-DESIGN.md and docs/PAWN-INTEGRATION-PLAN.md.
#
# A pawn is a type-2 "AddClass" character from the playerbots pool: a real
# character in a real group, so it keeps its gear and saves itself. It does not
# gain XP (Pawn.GainXP): it stays at the level it was hired at, and exchanging
# it for a fresher one as the player levels is the point of the roster. This
# module adds the four things the pool does not have on its own:
#
#   1. a roster, so a recruited pawn comes back after a relog or a restart;
#   2. a doorway on every innkeeper, with a paged picker that shows a rotating
#      subsample of the pool rather than all of it;
#   3. a level window, so the pawns offered are within Pawn.LevelWindow levels
#      of the player instead of snapping to the player's exact level;
#   4. an archetype per pawn: one premade PvE spec plus a hard spellbook
#      blacklist, so a pawn is a specialist and the player has to swap pawns
#      to get a different toolkit.
#
# The party cap (Pawn.MaxPawns) counts pawns only. Strangers met in the world
# are ordinary random bots and are not counted, so a full group still needs
# them - that is deliberate.
#
# Playerbots settings this module expects, written by scripts/thor-install.sh:
#   Playerbots.AddClassCommand = 0        the innkeeper picker is the only doorway
#   Playerbots.LootNeedRollLevel = 0      a pawn passes instead of needing
#   Playerbots.LootGreedRollLevel = 0     a pawn passes instead of greeding
#   Playerbots.FreeMethodLoot = 0         a pawn leaves free-for-all corpses
#   Playerbots.KeepAltsInGroup = 1        a pawn stays when the player relogs

# Master switch. 0 disables the innkeeper line and the login hooks; existing
# roster rows stay in the database and nothing is logged out.
# Default: 1 (enabled)
Pawn.Enable = 1

# How many pawns one player may keep in the party at once. The third recruit is
# refused at the innkeeper.
# Default: 2
Pawn.MaxPawns = 2

# How many levels above or below the player an offered pawn may be. Each pool
# pawn gets a stable offset inside this window, derived from the player and
# pawn guids, so the same pawn is always offered at the same level for the same
# player. 0 makes every pawn the player's exact level.
#
# It is also the band a pawn is still "current" in: one the player has outgrown
# by more than this is marked as fallen behind at the inn, and taking it on
# again at the new level is a new hire with a new fee.
# Default: 2
Pawn.LevelWindow = 2

# Whether a hired pawn keeps the experience it earns in the party. Off by
# default, and the default is the design: a pawn that levels with its owner
# never needs exchanging, so the roster would stop being a set of contracts that
# expire. With it off the pawn carries the core's no-XP-gain player flag, which
# Player::GiveXP checks before anything else - kills, quests, exploration and
# battlegrounds all go through that one call - and it is pinned to the level it
# was hired at even if something else moves it (playerbots rebuilds a type-2 bot
# at its master's level on login when the gap is more than three; the pin is
# applied after that pass).
#
# Set it to 1 to let pawns level in the party. The pin goes with it: the roster
# then follows the pawn's level instead of holding it, and exchanging companions
# becomes a choice rather than something progression forces.
# Default: 0 (a pawn does not gain XP)
Pawn.GainXP = 0

# What a hire costs, in copper, as a percentage of the player's level cubed:
#
#   fee = player_level^3 * HireFeePercent / 100 * gear_ratio / 100
#               * (100 + HireFeeHeldPercent * pawns_held) / 100
#
# player_level^3 copper is the **baseline**: the price of a pawn geared exactly like
# the player. gear_ratio is that pawn's own strength in percent of the player's
# gear score - a pawn a fifth weaker costs a fifth less, one half again as strong
# costs half again as much - and it is drawn per pawn, from the same seed as the
# level and the spec, triangular around 100 and clamped to
# [Pawn.GearFloorPercent, Pawn.GearCapPercent]. Most pawns therefore sit near the
# player's strength and near the baseline price; the picker row says which way each
# one went ("+20% gear", "-15% gear"), which is the only place the player needs to
# see it.
#
# The pawn's own level is deliberately not in the price. Inside the level window it
# moves the power less than the gear does, and pricing it made a level-20 draw twice
# as wide as a level-80 one.
#
# Level cubed copper is the point of the default. Measured against this server's
# own loot-bag money table (scripts/loot-bags/gen_loot_bags.py: normal creatures
# drop a bag 10% of the time, and the tier shares and money ranges are in MONEY),
# level^3 copper is about 10-20 minutes of ordinary farming at 100 kills an hour
# at every level that matters: 7 minutes at 10, 16 at 20, 20 at 30, 21 at 40-50,
# 18 at 60, 14 at 70, 10 at 80. The fee in copper is 80s at 20, 2g 70s at 30,
# 6g 40s at 40, 21g 60s at 60, 51g 20s at 80. The work it asks for therefore stays
# the same as the player levels instead of vanishing at 80 or being impossible at
# 10; quest money and vendor trash make it cheaper in practice, so treat those as
# upper bounds. 0 makes every hire free.
#
# A fee is per pawn *and per level*: calling back a pawn this owner has already
# paid for at the level it is standing at is free, so dismissing and re-hiring to
# rearrange a party costs nothing. Taking the same pawn on again at a new offer
# level is a new hire - a new build, new gear, a new fee - exactly as hiring a
# different pawn would be.
# Default: 100
Pawn.HireFeePercent = 100

# What each pawn already in the party adds to the price, as a percentage of the
# base fee: 100 means the second pawn costs twice the first, the third three
# times. A full party is an achievement, not the default state.
# Default: 100
Pawn.HireFeeHeldPercent = 100

# The band a pawn's gear ratio is drawn from, in percent of the player's gear
# score. The ratio is both the gear the pawn is built to and the multiplier on the
# hire fee, so this is also the band the price moves in: 85 and 150 mean a pawn can
# be a seventh weaker than the player for six sevenths of the baseline, or half
# again as strong for half again the baseline. The draw is triangular with its peak
# at 100, so most pawns are near the baseline price and the ends of the band are
# rare. The gear pass is held to
# GetMixedGearScore(owner) * ratio / 100 as its per-item score ceiling. Floor 100
# with cap 100 makes every pawn a match for the player and every price in a draw
# identical.
#
# One caveat: the ceiling only bites while the best items available at the pawn's
# level are above it. A raider at 80 already wears the best gear the level offers,
# so a high ratio buys the same gear as a low one there and only the price differs.
# Nothing at offer time can tell the two cases apart - the gear does not exist until
# the pawn is built.
# Defaults: 85 and 150
Pawn.GearFloorPercent = 85
Pawn.GearCapPercent = 150

# Offers per gossip page. The gossip packet carries at most 16 rows and the
# server aborts on a 33rd, so this is clamped to 16 minus the party rows and
# the two navigation rows.
# Default: 12
Pawn.OfferedPerPage = 12

# How many pawns one picker shows: a random count in [FeaturedMin, FeaturedMax]
# is taken from the pool every time a player opens the picker, and the result is
# kept while they browse it. Two players opening at once see different subsets,
# and so does the same player opening it twice.
#
# The pool is dealt, not sampled: each player gets a shuffled deck of the eligible
# pool and is dealt off the top of it, so no face comes round again until the whole
# deck has been dealt out - a fresh roll of the pool reshuffles it, and the visit
# before a reshuffle is dealt last in the new order, so a face never repeats in the
# very next visit either. On a pool of 75 per team a face comes back after about
# six visits, instead of the two or three faces out of twelve that a straight
# sample repeats on every visit.
#
# The pool is far larger than this on purpose, so the roster reads like a rift
# rather than a database dump. Recruiting or dismissing does not redraw; only
# reopening does.
# Defaults: 10 and 15
Pawn.FeaturedMin = 10
Pawn.FeaturedMax = 15

# How often the pool itself is re-read: which type-2 characters exist, their
# level and whether they are offline. A random number of minutes in
# [PoolRefreshMinMinutes, PoolRefreshMaxMinutes] is drawn each cycle, and the
# pool is also read at startup and on demand if it is still empty (a boot can
# finish before playerbots has created the pool characters).
# Defaults: 40 and 60
Pawn.PoolRefreshMinMinutes = 40
Pawn.PoolRefreshMaxMinutes = 60

# Log every recruit, dismiss, level and prune at INFO level. Leave 0 in normal
# play: the login path is noisy otherwise.
# Default: 0 (disabled)
Pawn.Debug = 0

########################################
# Archetypes: the spellbook a pawn never has
########################################
#
# One block per class and premade spec number, spelled
#   Pawn.Blacklist.<class>.<spec_no> = Spell Name, Spell Name, ...
#
# <class> is the ChrClasses id:
#   1 warrior   2 paladin   3 hunter   4 rogue   5 priest
#   6 death knight   7 shaman   8 mage   9 warlock   11 druid
#
# <spec_no> is the Playerbots.PremadeSpecLink number for that class, and the
# names are the ones Playerbots.PremadeSpecName gives it. Only the PvE specs
# are offered to a player, so only those need a block.
#
# Each list holds the signature abilities of the *other* specs of the same
# class: the spells a pawn must not have if it is to be a specialist. A prot
# warrior without Shield Wall cannot tank a boss for the player who brought an
# arms pawn; a shadow priest without Resurrection cannot replace the healer.
# That is the point: the toolkit is the reason to swap.
#
# Names, not ids, because a name is reviewable and a bare id is not. They are
# resolved against the spell table once at startup, and a name that resolves to
# nothing is logged as an error - a restriction that silently does nothing is
# worse than a loud one. Two known aliases are harmless: a spell that is shared
# between two specs ("Swipe", "Mangle") blacklists every spell of that name.
#
# Every name in this section and in the variant pools below was checked against
# the 3.3.5 spell table on 2026-10-26: 152 distinct names over 293 entries, all
# of them resolve, and none names an ability that only another class can learn.
# That check is a one-off and not part of the build, so a name added later is
# only proven by the `archetypes:` line in Server.log at the next startup.

# Warrior: arms, fury, prot
Pawn.Blacklist.1.0 = Shield Wall, Last Stand, Taunt, Devastate, Shield Slam, Spell Reflection
Pawn.Blacklist.1.1 = Shield Wall, Last Stand, Taunt, Devastate, Shield Slam, Spell Reflection
Pawn.Blacklist.1.2 = Mortal Strike, Bloodthirst, Bladestorm, Recklessness, Sweeping Strikes

# Paladin: holy, prot, ret
Pawn.Blacklist.2.0 = Crusader Strike, Divine Storm, Avenger's Shield, Hammer of the Righteous, Righteous Defense
Pawn.Blacklist.2.1 = Holy Light, Flash of Light, Holy Shock, Redemption, Divine Storm, Crusader Strike
Pawn.Blacklist.2.2 = Holy Light, Flash of Light, Holy Shock, Redemption, Avenger's Shield, Hammer of the Righteous, Righteous Defense

# Hunter: beast mastery, marksmanship, survival
Pawn.Blacklist.3.0 = Aimed Shot, Chimera Shot, Explosive Shot, Black Arrow
Pawn.Blacklist.3.1 = Bestial Wrath, Kill Command, Explosive Shot, Black Arrow
Pawn.Blacklist.3.2 = Aimed Shot, Chimera Shot, Bestial Wrath, Kill Command

# Rogue: assassination, combat, subtlety. Subtlety keeps the crowd control.
Pawn.Blacklist.4.0 = Blade Flurry, Adrenaline Rush, Shadowstep, Premeditation, Hemorrhage, Sap, Blind, Vanish
Pawn.Blacklist.4.1 = Mutilate, Hunger for Blood, Shadowstep, Premeditation, Hemorrhage, Sap, Blind, Vanish
Pawn.Blacklist.4.2 = Mutilate, Hunger for Blood, Blade Flurry, Adrenaline Rush

# Priest: discipline, holy, shadow. Shadow keeps no resurrection and no group heal.
Pawn.Blacklist.5.0 = Shadowform, Mind Flay, Vampiric Touch, Devouring Plague, Mind Blast
Pawn.Blacklist.5.1 = Shadowform, Mind Flay, Vampiric Touch, Devouring Plague, Mind Blast
Pawn.Blacklist.5.2 = Greater Heal, Circle of Healing, Prayer of Healing, Holy Nova, Resurrection, Renew

# Death knight: blood, frost, unholy
Pawn.Blacklist.6.0 = Howling Blast, Frost Strike, Scourge Strike, Summon Gargoyle, Unholy Blight
Pawn.Blacklist.6.1 = Vampiric Blood, Rune Tap, Scourge Strike, Summon Gargoyle, Unholy Blight
Pawn.Blacklist.6.2 = Vampiric Blood, Rune Tap, Howling Blast, Frost Strike

# Shaman: elemental, enhancement, restoration
Pawn.Blacklist.7.0 = Stormstrike, Lava Lash, Riptide, Chain Heal, Healing Wave, Lesser Healing Wave, Ancestral Spirit
Pawn.Blacklist.7.1 = Chain Lightning, Lava Burst, Chain Heal, Riptide, Ancestral Spirit
Pawn.Blacklist.7.2 = Stormstrike, Lava Lash, Chain Lightning, Lava Burst, Lightning Bolt

# Mage: arcane, fire, frost
Pawn.Blacklist.8.0 = Fireball, Pyroblast, Fire Blast, Combustion, Frostbolt, Ice Lance, Icy Veins, Blizzard, Summon Water Elemental
Pawn.Blacklist.8.1 = Arcane Blast, Arcane Missiles, Arcane Barrage, Frostbolt, Ice Lance, Icy Veins, Blizzard, Summon Water Elemental
Pawn.Blacklist.8.2 = Arcane Blast, Arcane Missiles, Arcane Barrage, Fireball, Pyroblast, Fire Blast, Combustion

# Warlock: affliction, demonology, destruction
Pawn.Blacklist.9.0 = Incinerate, Chaos Bolt, Conflagrate, Soul Fire, Summon Felguard, Demonic Empowerment
Pawn.Blacklist.9.1 = Unstable Affliction, Haunt, Incinerate, Chaos Bolt, Conflagrate, Soul Fire
Pawn.Blacklist.9.2 = Unstable Affliction, Haunt, Summon Felguard, Demonic Empowerment

# Druid: balance, bear, restoration, cat
Pawn.Blacklist.11.0 = Mangle, Shred, Rip, Maul, Swipe, Growl, Healing Touch, Rejuvenation, Lifebloom, Swiftmend, Rebirth, Tranquility
Pawn.Blacklist.11.1 = Starfire, Wrath, Starfall, Moonfire, Shred, Rip, Pounce, Healing Touch, Rejuvenation, Lifebloom, Swiftmend, Rebirth, Tranquility
Pawn.Blacklist.11.2 = Starfire, Wrath, Starfall, Mangle, Shred, Rip, Maul, Swipe, Growl
Pawn.Blacklist.11.3 = Starfire, Wrath, Starfall, Maul, Swipe, Growl, Healing Touch, Rejuvenation, Lifebloom, Swiftmend, Rebirth, Tranquility

########################################
#
# Per-pawn variants: the second half of an archetype.
#
# The blacklist above makes a pawn a specialist. This makes two pawns of the
# *same* spec different companions: each list is a pool of abilities that a pawn
# of that spec may or may not arrive with, and each pawn is dealt a subset of it
# from the same seed as its level, spec and gear ratio - so the same face always
# arrives with the same toolkit for the same player, and two fury warriors do
# not.
#
# The abilities chosen are the situational ones: interrupts, taunts, cooldowns,
# dispels and crowd control. Losing an interrupt makes a pawn that cannot stop a
# heal; losing a cooldown makes it squishier; losing a fear makes it a different
# fight. Rotational damage or healing is never in a pool - a pawn missing its
# rotation is broken, not different.
#
#   Pawn.Variant.<class>.<spec_no> = Spell Name, Spell Name, ...
#
# Same class ids and spec numbers as the blacklist. An empty or missing block
# means every pawn of that spec arrives with the full toolkit. Names resolve
# against the spell table once at startup, exactly like the blacklist, and an
# unresolved name is an ERROR in the log - check the `archetypes:` line in
# Server.log after a config change.

# How many abilities from a spec's pool a pawn is missing: the count is drawn
# uniformly from [Min, Max], capped by the pool size. Min is what guarantees two
# pawns of one spec never arrive with identical kits - with the shipped pools of
# three and Min 1, Max 2, a pawn is missing one or two of them in equal measure.
# Min 0 lets a pawn arrive with its whole pool; Max 0 turns the variation off.
# A Min above Max is read as Max, and a Min above the pool size as the pool size.
# Default: 1
Pawn.VariantWithholdMin = 1

# Default: 2
Pawn.VariantWithholdMax = 2

# Warrior: arms, fury, prot
Pawn.Variant.1.0 = Pummel, Mocking Blow, Retaliation
Pawn.Variant.1.1 = Pummel, Recklessness, Death Wish
Pawn.Variant.1.2 = Pummel, Spell Reflection, Last Stand

# Paladin: holy, prot, ret
Pawn.Variant.2.0 = Hammer of Justice, Turn Evil, Lay on Hands
Pawn.Variant.2.1 = Hammer of Justice, Turn Evil, Divine Protection
Pawn.Variant.2.2 = Hammer of Justice, Turn Evil, Repentance

# Hunter: beast mastery, marksmanship, survival
Pawn.Variant.3.0 = Concussive Shot, Feign Death, Deterrence
Pawn.Variant.3.1 = Concussive Shot, Feign Death, Misdirection
Pawn.Variant.3.2 = Concussive Shot, Feign Death, Wyvern Sting

# Rogue: assassination, combat, subtlety
Pawn.Variant.4.0 = Kick, Evasion, Cloak of Shadows
Pawn.Variant.4.1 = Kick, Evasion, Sprint
Pawn.Variant.4.2 = Kick, Evasion, Vanish

# Priest: discipline, holy, shadow
Pawn.Variant.5.0 = Dispel Magic, Shackle Undead, Fear Ward
Pawn.Variant.5.1 = Dispel Magic, Shackle Undead, Fade
Pawn.Variant.5.2 = Dispel Magic, Shackle Undead, Psychic Scream

# Death knight: blood, frost, unholy
Pawn.Variant.6.0 = Mind Freeze, Strangulate, Anti-Magic Shell
Pawn.Variant.6.1 = Mind Freeze, Strangulate, Chains of Ice
Pawn.Variant.6.2 = Mind Freeze, Strangulate, Anti-Magic Zone

# Shaman: elemental, enhancement, restoration
Pawn.Variant.7.0 = Wind Shear, Grounding Totem, Tremor Totem
Pawn.Variant.7.1 = Wind Shear, Grounding Totem, Frost Shock
Pawn.Variant.7.2 = Wind Shear, Grounding Totem, Frost Shock

# Mage: arcane, fire, frost
Pawn.Variant.8.0 = Counterspell, Polymorph, Spellsteal
Pawn.Variant.8.1 = Counterspell, Polymorph, Blink
Pawn.Variant.8.2 = Counterspell, Polymorph, Ice Block

# Warlock: affliction, demonology, destruction
Pawn.Variant.9.0 = Fear, Banish, Curse of Tongues
Pawn.Variant.9.1 = Fear, Banish, Howl of Terror
Pawn.Variant.9.2 = Fear, Banish, Shadowfury

# Druid: balance, bear, restoration, cat
Pawn.Variant.11.0 = Entangling Roots, Hibernate, Cyclone
Pawn.Variant.11.1 = Bash, Feral Charge, Survival Instincts
Pawn.Variant.11.2 = Entangling Roots, Hibernate, Nature's Swiftness
Pawn.Variant.11.3 = Dash, Cower, Survival Instincts

########################################
#
# Per-pawn voice and temperament: how a pawn sounds and how it fights.
#
# The variant blocks above give a pawn its own toolkit. These two give it a
# manner. Both are drawn from the same seed as its level and spec, so a face
# never changes under the owner who hired it.
#
# A profile list is not a number: each `Label: +strategy,-strategy` entry is one
# profile, entries are separated by `|`, and the pawn is dealt one of them. A
# profile may move two dials at once; join them with a comma and no space,
# because the engine's own parser does not trim the tokens it splits on.
#
# Voice drives the non-combat engine and answers how the pawn sounds between
# fights. One pool serves every pawn - a voice is a manner, not a spec. `emote`
# is the strategy that drives talking and emoting and it is on for bots by
# default, so `-emote` is what makes a pawn quiet. Two realm-wide settings keep
# the last word underneath: Playerbots.RandomBotTalk and Playerbots.RandomBotEmote
# in playerbots.conf gate whether a bot may speak at all, so a silent realm
# cannot be talked into life by this file.
#
# Default: Talkative: +emote | Quiet: -emote
Pawn.Voice = Talkative: +emote | Quiet: -emote

# Temperament drives the combat engine and answers how the pawn fights. Unlike
# voice it is per spec, because what bold means for a fury warrior is not what
# it means for a holy priest - a tank that charges in dies, and a healer that
# charges in wipes the party. Each spec carries two or three profiles and the
# pawn gets one of them, so two arms warriors fight differently and neither
# fights wrong. Only strategy dials are touched here; the class rotation is
# left alone. An unknown strategy name is ignored by the engine, so a typo
# makes a pawn ordinary rather than broken.
#
#   Pawn.Temperament.<class>.<spec_no> = Label: +strategy | Label: ...
#
# Two dials are not what they look like. `save mana` is the healer mana
# multiplier and returns 1.0 for anything that is not a healing cast, so it
# does nothing on a tank or a dps. `close` and `ranged` add melee and ranged
# combat, which a death knight, mage or priest already has from its class
# strategy, so those tokens are dead on those classes.
#
# Same class ids and spec numbers as the blacklist and variant blocks. The loader
# reads the keys that exist rather than asking for every class and spec in turn,
# so a spec with no `<class>.<spec>` key has no temperament at all and nothing is
# logged for it - the class x spec grid is mostly undefined by design. An empty
# block is dropped the same way.
#
# The profile is applied on top of the strategy list playerbots replayed from the
# pawn's last logout, not on the role defaults, so the module first undoes the
# dials the pool's other profiles name. A dial removed from every profile of a
# pool is named by nothing and lingers until the pawn is re-hired.

# Warrior: arms, fury, prot
Pawn.Temperament.1.0 = Relentless: +aggressive,+close | Patient: +wait for attack | Wary: +avoid aoe
Pawn.Temperament.1.1 = Reckless: +aggressive | Careful: +avoid aoe,-potions | Steady: +close
Pawn.Temperament.1.2 = Stalwart: +close | Wary: +avoid aoe | Frugal: -potions

# Paladin: holy, prot, ret
Pawn.Temperament.2.0 = Frugal: +save mana | Distant: +ranged | Careful: +avoid aoe
Pawn.Temperament.2.1 = Stalwart: +close | Frugal: -potions | Wary: +avoid aoe
Pawn.Temperament.2.2 = Relentless: +aggressive,+close | Spare: -potions | Careful: +avoid aoe

# Hunter: beast mastery, marksmanship, survival
Pawn.Temperament.3.0 = Bold: +aggressive | Distant: +ranged | Restless: +kite
Pawn.Temperament.3.1 = Patient: +wait for attack | Distant: +ranged | Spare: -potions
Pawn.Temperament.3.2 = Bold: +aggressive,+ranged | Restless: +kite | Wary: +avoid aoe

# Rogue: assassination, combat, subtlety
Pawn.Temperament.4.0 = Relentless: +aggressive,+close | Spare: -potions | Wary: +avoid aoe
Pawn.Temperament.4.1 = Steady: +close | Bold: +aggressive | Spare: -potions
Pawn.Temperament.4.2 = Patient: +wait for attack | Careful: +avoid aoe | Relentless: +aggressive

# Priest: discipline, holy, shadow
Pawn.Temperament.5.0 = Frugal: +save mana | Careful: +avoid aoe | Spare: -potions
Pawn.Temperament.5.1 = Frugal: +save mana | Restless: +kite | Careful: +avoid aoe
Pawn.Temperament.5.2 = Bold: +aggressive | Restless: +kite | Wary: +avoid aoe

# Death knight: blood, frost, unholy, double aura blood
Pawn.Temperament.6.0 = Stalwart: +avoid aoe | Frugal: -potions
Pawn.Temperament.6.1 = Relentless: +aggressive | Spare: -potions | Wary: +avoid aoe
Pawn.Temperament.6.2 = Bold: +aggressive | Patient: +wait for attack | Careful: +avoid aoe
Pawn.Temperament.6.3 = Wary: +avoid aoe | Spare: -potions

# Shaman: elemental, enhancement, restoration
Pawn.Temperament.7.0 = Bold: +aggressive,+ranged | Restless: +kite | Wary: +avoid aoe
Pawn.Temperament.7.1 = Relentless: +aggressive,+close | Spare: -potions | Careful: +avoid aoe
Pawn.Temperament.7.2 = Frugal: +save mana | Distant: +ranged | Careful: +avoid aoe

# Mage: arcane, fire, frost, frostfire
Pawn.Temperament.8.0 = Bold: +aggressive | Frugal: -potions | Careful: +avoid aoe
Pawn.Temperament.8.1 = Reckless: +aggressive | Distant: +kite | Careful: +avoid aoe
Pawn.Temperament.8.2 = Careful: +avoid aoe | Restless: +kite | Frugal: -potions
Pawn.Temperament.8.3 = Bold: +aggressive | Patient: +wait for attack | Spare: -potions

# Warlock: affliction, demonology, destruction
Pawn.Temperament.9.0 = Patient: +wait for attack | Careful: +avoid aoe | Restless: +kite
Pawn.Temperament.9.1 = Bold: +aggressive,+ranged | Frugal: -potions | Careful: +avoid aoe
Pawn.Temperament.9.2 = Reckless: +aggressive | Distant: +ranged | Spare: -potions

# Druid: balance, bear, restoration, cat
Pawn.Temperament.11.0 = Distant: +ranged | Bold: +aggressive | Wary: +avoid aoe
Pawn.Temperament.11.1 = Stalwart: +close | Wary: +avoid aoe | Frugal: -potions
Pawn.Temperament.11.2 = Frugal: +save mana | Careful: +avoid aoe | Distant: +ranged
Pawn.Temperament.11.3 = Relentless: +aggressive,+close | Patient: +wait for attack | Spare: -potions
