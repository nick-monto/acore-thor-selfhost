# Python bytecode from scripts/creature-gear. check_creature_gear.py imports gen_creature_gear.py
# as a sibling and sets sys.dont_write_bytecode itself, so this is insurance for other ways of
# running them (python3 -m, an IDE, pytest), not a fix.
__pycache__/
*.py[cod]

# Local builds. The workflow builds a core checkout under src/ inside the runner's workspace, and
# installs to /opt/acore; reproducing either locally must not end up in a commit.
/build/

# Assets the docs tell you to download on the device (scripts/thor-install.sh does it in /tmp).
acore-server-arm64.tar.zst*
data.zip

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# NOT ignored on purpose: modules/mod-creature-gear/data/sql/ is generated by
# scripts/creature-gear/gen_creature_gear.py but committed, because the DB updater and the release
# artifact read the module's SQL from the tree. Never add *.sql or data/ rules here.
