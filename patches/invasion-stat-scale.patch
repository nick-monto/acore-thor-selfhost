+// (all-default) scale is the normal template path; a non-default scale is how
+// dynamic spawns (world events, summons) get level-appropriate health, damage,
+// armor and spell power without changing the creature entry.
+struct CreatureStatScale
+{
+    float health = 1.0f;
+    float mana = 1.0f;
+    float damage = 1.0f;
+    float armor = 1.0f;
+    float spellDamage = 1.0f;
+    float healing = 1.0f;
+    uint8 level = 0;            // 0 = keep the template-rolled level
+};
