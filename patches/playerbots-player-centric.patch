+# Keep randombots in the zone of real players instead of spreading them across the whole world.
+# Each randombot is assigned to a real (non-GM) open-world player; its level is kept within
+# +/- RandomBotNearPlayersLevelRange of that player, and it is placed at a safe level-appropriate
+# travel location inside that player's current zone. Bots grouped with a real player, in
+# instances, battlegrounds or flight are left alone, and nothing is ever placed on top of the
+# player. Falls back to normal randombot behaviour when no eligible player is online.
+#
+# This supersedes Playerbots.SyncLevelWithPlayers for level selection and
+# Playerbots.RandomBotConcentrateInPlayerZone for teleport target. Do not enable
+# Playerbots.LevelBrackets.Enabled at the same time: both features change bot levels and would
+# fight each other.
+# Default: 0 (disabled)
+Playerbots.RandomBotNearPlayers = 0
+
+# Maximum number of levels a randombot may be above or below its assigned player.
+# Default: 5
+Playerbots.RandomBotNearPlayersLevelRange = 5
+
+# How often (in seconds) a bot that has drifted out of its assigned player's zone is moved back.
+# Default: 120
+Playerbots.RandomBotNearPlayersFollowInterval = 120
+
+# Smallest distance (in yards) a bot may be placed from its assigned player when it arrives in the
+# player's zone. Travel locations inside that distance are skipped, so an arrival never looks like
+# a bot landing on the player: 100 is about where a 3.3.5a client stops drawing other players. 0
+# allows placement anywhere.
+# Default: 100.0
+Playerbots.RandomBotNearPlayersMinDistance = 100.0
+
+# Restrict each bot to players of its own faction. Disable to let both factions gather around
+# the same player (the bot AI may then treat the player as a PvP target).
+# Default: 1 (enabled)
+Playerbots.RandomBotNearPlayersSameFaction = 1
+
+# Maximum number of randombots assigned to one player, which is also the most that can be in that
+# player's zone at once. 0 distributes bots evenly across all eligible players without a cap.
+# Default: 10
+Playerbots.RandomBotNearPlayersMaxPerPlayer = 10
+
+# Simulate zone traffic: each bot spends a while in the zone and then leaves for another zone for a
+# while, so the population around the player keeps changing instead of standing still. A bot only
+# leaves once it is far enough away that the player cannot watch it go, and it is never pulled back
+# before its return time. Disable to keep every assigned bot in the zone permanently.
+# Default: 1 (enabled)
+Playerbots.RandomBotNearPlayersZoneTraffic = 1
+
+# How long (in seconds) a bot stays in the zone before it may leave. Randomised per visit.
+# Default: 900 (15 minutes)
+Playerbots.RandomBotNearPlayersZoneVisitMinTime = 900
+
+# Default: 2400 (40 minutes)
+Playerbots.RandomBotNearPlayersZoneVisitMaxTime = 2400
+
+# How long (in seconds) a bot stays away before it returns to the player's zone. Randomised per
+# trip, and only counted down while the bot is eligible to be moved.
+# Default: 240 (4 minutes)
+Playerbots.RandomBotNearPlayersZoneAwayMinTime = 240
+
+# Default: 600 (10 minutes)
+Playerbots.RandomBotNearPlayersZoneAwayMaxTime = 600
+
 # Mark many quests ≤ bot level as complete (slows down bot creation)
 # Default: 0 (disabled)
 Playerbots.PreQuests = 0
