+# Keep randombots around real players instead of spreading them across the whole world.
+# Each randombot is assigned to a real (non-GM) open-world player; its level is kept within
+# +/- RandomBotNearPlayersLevelRange of that player, and it is moved to that player's zone when
+# it drifts away. Bots grouped with a real player, in instances, battlegrounds or flight are left
+# alone. Falls back to normal randombot behaviour when no eligible player is online.
+#
+# This supersedes Playerbots.SyncLevelWithPlayers for level selection and
+# Playerbots.RandomBotConcentrateInPlayerZone for teleport target. Do not enable
+# Playerbots.LevelBrackets.Enabled at the same time: both features change bot levels and would
+# fight each other.
+# Default: 0 (disabled)
+Playerbots.RandomBotNearPlayers = 0
+
+# Maximum number of levels a randombot may be above or below its assigned player.
+# Default: 5
+Playerbots.RandomBotNearPlayersLevelRange = 5
+
+# How often (in seconds) a bot that has drifted away from its assigned player is moved back.
+# Default: 120
+Playerbots.RandomBotNearPlayersFollowInterval = 120
+
+# Preferred distance (in yards) from the assigned player when placing a bot. The actual distance
+# is randomized between roughly a third of this value and the value itself.
+# Default: 60.0
+Playerbots.RandomBotNearPlayersRadius = 60.0
+
+# Restrict each bot to players of its own faction. Disable to let both factions gather around
+# the same player (the bot AI may then treat the player as a PvP target).
+# Default: 1 (enabled)
+Playerbots.RandomBotNearPlayersSameFaction = 1
+
+# Maximum number of randombots assigned to one player. 0 distributes bots evenly across all
+# eligible players without a cap.
+# Default: 0
+Playerbots.RandomBotNearPlayersMaxPerPlayer = 0
+
 # Mark many quests ≤ bot level as complete (slows down bot creation)
 # Default: 0 (disabled)
 Playerbots.PreQuests = 0
