+// A real player is a valid player-centric anchor when it is online in the open world, awake, and
+// not in an instance, battleground, arena or on a transport. Bots never anchor to GMs.
+bool RandomPlayerbotMgr::IsPlayerCentricTargetValid(Player* player, Player* bot)
+{
+    if (!player || !bot || !player->IsInWorld() || player->IsGameMaster() || player->isDead())
+        return false;
+
+    // Only real players anchor bots; self-bots and other playerbot-driven characters do not.
+    if (GET_PLAYERBOT_AI(player))
+        return false;
+
+    if (player->IsBeingTeleported() || player->IsInFlight() || player->IsFlying() || player->InBattleground() ||
+        player->InArena() || player->IsInWater())
+        return false;
+
+    if (player->GetTransport())
+        return false;
+
+    Map* map = player->GetMap();
+    if (!map || map->Instanceable())
+        return false;
+
+    if (std::find(sPlayerbotAIConfig.RandomBotMaps.begin(), sPlayerbotAIConfig.RandomBotMaps.end(), map->GetId()) ==
+        sPlayerbotAIConfig.RandomBotMaps.end())
+        return false;
+
+    if (sPlayerbotAIConfig.RandomBotNearPlayersSameFaction && player->GetTeamId() != bot->GetTeamId())
+        return false;
+
+    // A Death Knight cannot be placed within the requested range of a low-level player, so leave
+    // that bot on the normal distribution instead of creating an out-of-range level 55 bot.
+    if (bot->getClass() == CLASS_DEATH_KNIGHT)
+    {
+        uint8 dkMinLevel = sWorld->getIntConfig(CONFIG_START_HEROIC_PLAYER_LEVEL);
+        if (player->GetLevel() + sPlayerbotAIConfig.RandomBotNearPlayersLevelRange < dkMinLevel)
+            return false;
+    }
+
+    return true;
+}
+
+// Player-centric movement is only safe for ungrouped, living bots that are not busy in an
+// instance, battleground, flight or combat. Grouped bots are left alone so a teleport cannot
+// split a group.
+bool RandomPlayerbotMgr::IsPlayerCentricBotEligible(Player* bot)
+{
+    if (!sPlayerbotAIConfig.RandomBotNearPlayers || !bot || !bot->IsInWorld())
+        return false;
+
+    if (!IsRandomBot(bot) || bot->isDead() || bot->IsInCombat() || bot->IsBeingTeleported() || bot->IsRooted() ||
+        bot->IsInFlight() || bot->IsFlying())
+        return false;
+
+    if (bot->InBattleground() || bot->InArena() || bot->inRandomLfgDungeon() || bot->InBattlegroundQueue())
+        return false;
+
+    Map* map = bot->GetMap();
+    if (!map || map->Instanceable())
+        return false;
+
+    if (bot->GetGroup())
+        return false;
+
+    PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot);
+    if (!botAI || botAI->GetMaster())
+        return false;
+
+    return true;
+}
+
+// Returns the bot's assigned player, assigning the least-loaded eligible player when there is no
+// valid assignment yet. Returns nullptr when no eligible player is online, letting the caller fall
+// back to the normal randombot behaviour.
+Player* RandomPlayerbotMgr::GetPlayerCentricTarget(Player* bot)
+{
+    if (!sPlayerbotAIConfig.RandomBotNearPlayers || !bot || players.empty())
+        return nullptr;
+
+    uint32 botId = bot->GetGUID().GetCounter();
+    auto assigned = playerCentricTargets.find(botId);
+    if (assigned != playerCentricTargets.end())
+    {
+        Player* target = ObjectAccessor::FindConnectedPlayer(assigned->second);
+        if (IsPlayerCentricTargetValid(target, bot))
+            return target;
+
+        playerCentricTargets.erase(assigned);
+        playerCentricFollowAt.erase(botId);
+        playerCentricLeaveAt.erase(botId);
+        playerCentricAwayUntil.erase(botId);
+    }
+
+    std::unordered_map<uint32, uint32> assignments;
+    for (auto const& [assignedBotId, targetGuid] : playerCentricTargets)
+    {
+        if (!GetPlayerBot(ObjectGuid::Create<HighGuid::Player>(assignedBotId)))
+            continue;
+
+        assignments[targetGuid.GetCounter()]++;
+    }
+
+    Player* best = nullptr;
+    uint32 bestCount = ~0u;
+    for (Player* player : players)
+    {
+        if (!IsPlayerCentricTargetValid(player, bot))
+            continue;
+
+        uint32 count = assignments[player->GetGUID().GetCounter()];
+        if (sPlayerbotAIConfig.RandomBotNearPlayersMaxPerPlayer > 0 &&
+            count >= sPlayerbotAIConfig.RandomBotNearPlayersMaxPerPlayer)
+            continue;
+
+        // Reservoir-sample ties so bots spread evenly over equally loaded players.
+        if (count < bestCount || (count == bestCount && urand(0, 1) == 0))
+        {
+            best = player;
+            bestCount = count;
+        }
+    }
+
+    if (!best)
+        return nullptr;
+
+    playerCentricTargets[botId] = best->GetGUID();
+    // A fresh assignment gets a full visit before traffic may send it away, randomised so a login
+    // does not empty the zone in one wave later on.
+    playerCentricLeaveAt[botId] = static_cast<uint32>(time(nullptr)) +
+                                  urand(sPlayerbotAIConfig.RandomBotNearPlayersZoneVisitMinTime,
+                                        sPlayerbotAIConfig.RandomBotNearPlayersZoneVisitMaxTime);
+    return best;
+}
+
+void RandomPlayerbotMgr::GetPlayerCentricLevelBounds(Player* bot, Player* target, uint8& low, uint8& high)
+{
+    uint32 range = sPlayerbotAIConfig.RandomBotNearPlayersLevelRange;
+    uint32 targetLevel = target->GetLevel();
+    uint32 minLevel = sPlayerbotAIConfig.RandomBotMinLevel;
+    uint32 maxLevel = sPlayerbotAIConfig.RandomBotMaxLevel;
+
+    low = static_cast<uint8>(std::max(minLevel, targetLevel > range ? targetLevel - range : 1));
+    high = static_cast<uint8>(std::min(maxLevel, targetLevel + range));
+
+    if (bot && bot->getClass() == CLASS_DEATH_KNIGHT)
+    {
+        uint8 dkMinLevel = sWorld->getIntConfig(CONFIG_START_HEROIC_PLAYER_LEVEL);
+        low = std::max(low, dkMinLevel);
+        high = std::max(high, low);
+    }
+
+    if (low > high)
+    {
+        low = high = static_cast<uint8>(std::min(maxLevel, std::max(minLevel, targetLevel)));
+    }
+}
+
+bool RandomPlayerbotMgr::AdjustBotLevel(Player* bot, uint8 level)
+{
+    if (!bot || level == 0 || level == bot->GetLevel())
+        return false;
+
+    if (bot->IsMounted())
+        bot->Dismount();
+
+    PlayerbotFactory factory(bot, level);
+    factory.Randomize(false);
+    SetValue(bot, "level", level);
+    return true;
+}
+
+// A zone bot only leaves once it is far enough away that the player cannot watch it go: a 3.3.5a
+// client stops drawing units around 100 yards out.
+static constexpr float PLAYER_CENTRIC_UNSEEN_DISTANCE = 100.0f;
+
+// The zone the player is standing in, or 0 when the client has not placed them in one yet.
+uint32 RandomPlayerbotMgr::GetPlayerCentricZoneId(Player* player)
+{
+    Map* map = player ? player->GetMap() : nullptr;
+    if (!map)
+        return 0;
+
+    return map->GetZoneId(PHASEMASK_NORMAL, player->GetPositionX(), player->GetPositionY(), player->GetPositionZ());
+}
+
+// True while the bot shares the map and zone of its assigned player, which is the only place a
+// player-centric bot is allowed to be.
+bool RandomPlayerbotMgr::IsBotInPlayerZone(Player* bot, Player* target)
+{
+    if (!bot || !target || bot->GetMapId() != target->GetMapId())
+        return false;
+
+    Map* map = bot->GetMap();
+    uint32 targetZone = GetPlayerCentricZoneId(target);
+    if (!map || !targetZone)
+        return false;
+
+    return map->GetZoneId(PHASEMASK_NORMAL, bot->GetPositionX(), bot->GetPositionY(), bot->GetPositionZ()) ==
+           targetZone;
+}
+
+// Places the bot in the assigned player's zone, or - when inPlayerZone is false - at a
+// level-appropriate location somewhere else, which is how a zone bot leaves. Placement uses the
+// normal travel locations, so roads, hubs and quest areas across the zone are populated instead of
+// only the player's immediate surroundings. In-zone arrivals keep
+// RandomBotNearPlayersMinDistance yards of clearance, so a bot never lands on the player.
+bool RandomPlayerbotMgr::TeleportBotToTargetZone(Player* bot, Player* target, bool inPlayerZone)
+{
+    if (!bot || !target || !bot->IsInWorld() || !target->IsInWorld())
+        return false;
+
+    if (bot->IsBeingTeleported() || target->IsBeingTeleported() || bot->IsInCombat() || bot->IsRooted() ||
+        bot->isDead() || bot->InBattleground() || bot->InArena() || bot->InBattlegroundQueue() || bot->GetGroup())
+        return false;
+
+    Map* targetMap = target->GetMap();
+    if (!targetMap || targetMap->Instanceable())
+        return false;
+
+    uint32 targetZone = GetPlayerCentricZoneId(target);
+    if (inPlayerZone && !targetZone)
+        return false;
+
+    if (inPlayerZone)
+    {
+        AreaTableEntry const* zone = sAreaTableStore.LookupEntry(targetZone);
+        if (zone && ((zone->team == 4 && bot->GetTeamId() == TEAM_ALLIANCE) ||
+                     (zone->team == 2 && bot->GetTeamId() == TEAM_HORDE)))
+            return false;
+    }
+
+    std::vector<WorldLocation> locs = sTravelMgr.GetTeleportLocations(bot);
+    std::vector<WorldLocation> wanted;
+    for (WorldLocation const& loc : locs)
+    {
+        bool sameMap = loc.GetMapId() == targetMap->GetId();
+        bool sameZone = sameMap && sMapMgr->GetZoneId(PHASEMASK_NORMAL, loc) == targetZone;
+
+        if (!inPlayerZone)
+        {
+            // Leaving means actually leaving: anywhere but the zone the player is watching.
+            if (!sameZone)
+                wanted.push_back(loc);
+
+            continue;
+        }
+
+        if (!sameZone)
+            continue;
+
+        if (target->GetDistance(loc.GetPositionX(), loc.GetPositionY(), loc.GetPositionZ()) <
+            sPlayerbotAIConfig.RandomBotNearPlayersMinDistance)
+            continue;
+
+        wanted.push_back(loc);
+    }
+
+    if (wanted.empty())
+        return false;
+
+    RandomTeleport(bot, wanted, false);
+    return true;
+}
+
+// Puts the bot in its assigned player's zone and starts a new visit. Returns false when the zone has
+// no usable location, so the caller can let the normal distribution place the bot instead.
+bool RandomPlayerbotMgr::PlaceBotInPlayerZone(Player* bot, Player* target, uint32 now)
+{
+    if (!TeleportBotToTargetZone(bot, target, true))
+    {
+        playerCentricFollowAt[bot->GetGUID().GetCounter()] = now + 15;
+        return false;
+    }
+
+    uint32 botId = bot->GetGUID().GetCounter();
+    playerCentricAwayUntil.erase(botId);
+    playerCentricFollowAt[botId] = now + sPlayerbotAIConfig.RandomBotNearPlayersFollowInterval;
+    playerCentricLeaveAt[botId] = now + urand(sPlayerbotAIConfig.RandomBotNearPlayersZoneVisitMinTime,
+                                              sPlayerbotAIConfig.RandomBotNearPlayersZoneVisitMaxTime);
+    return true;
+}
+
+// Sends the bot to another zone for a while: this mode's version of a player walking out.
+// Returns false when there is nowhere else to go, so the bot simply stays.
+bool RandomPlayerbotMgr::SendBotAwayFromPlayerZone(Player* bot, Player* target, uint32 now)
+{
+    if (!TeleportBotToTargetZone(bot, target, false))
+        return false;
+
+    uint32 botId = bot->GetGUID().GetCounter();
+    playerCentricAwayUntil[botId] = now + urand(sPlayerbotAIConfig.RandomBotNearPlayersZoneAwayMinTime,
+                                                sPlayerbotAIConfig.RandomBotNearPlayersZoneAwayMaxTime);
+    playerCentricFollowAt[botId] = now + sPlayerbotAIConfig.RandomBotNearPlayersFollowInterval;
+    return true;
+}
+
+// Periodic pass that keeps the online random bots level-appropriate for, and inside the zone of,
+// the real players, and that makes the zone population change over time instead of standing still.
+// It is deliberately rate-limited: a handful of bots are processed per manager tick so a large bot
+// population cannot turn a player login into a spike.
+void RandomPlayerbotMgr::UpdatePlayerCentricBots()
+{
+    if (!sPlayerbotAIConfig.RandomBotNearPlayers || players.empty())
+        return;
+
+    uint32 now = static_cast<uint32>(time(nullptr));
+
+    for (auto it = playerCentricTargets.begin(); it != playerCentricTargets.end();)
+    {
+        uint32 botId = it->first;
+        Player* assignedBot = GetPlayerBot(ObjectGuid::Create<HighGuid::Player>(botId));
+        if (!assignedBot || !IsPlayerCentricBotEligible(assignedBot))
+        {
+            playerCentricFollowAt.erase(botId);
+            playerCentricLeaveAt.erase(botId);
+            playerCentricAwayUntil.erase(botId);
+            it = playerCentricTargets.erase(it);
+        }
+        else
+        {
+            ++it;
+        }
+    }
+
+    uint32 actions = 0;
+    uint32 maxActions = _isBotInitializing ? 2 : 5;
+    PlayerBotMap bots = GetAllBots();
+
+    for (auto const& [botGuid, bot] : bots)
+    {
+        if (actions >= maxActions)
+            break;
+
+        if (!IsPlayerCentricBotEligible(bot))
+            continue;
+
+        Player* target = GetPlayerCentricTarget(bot);
+        if (!target)
+            continue;
+
+        uint32 botId = botGuid.GetCounter();
+        uint8 low, high;
+        GetPlayerCentricLevelBounds(bot, target, low, high);
+
+        if (!sPlayerbotAIConfig.DisableRandomLevels && !sPlayerbotAIConfig.RandomBotFixedLevel &&
+            (bot->GetLevel() < low || bot->GetLevel() > high))
+        {
+            if (AdjustBotLevel(bot, static_cast<uint8>(urand(low, high))))
+            {
+                // A full re-randomisation may move the bot, so give it a fresh visit either way.
+                playerCentricLeaveAt[botId] = now + urand(sPlayerbotAIConfig.RandomBotNearPlayersZoneVisitMinTime,
+                                                          sPlayerbotAIConfig.RandomBotNearPlayersZoneVisitMaxTime);
+                ++actions;
+            }
+
+            continue;
+        }
+
+        if (now < playerCentricFollowAt[botId])
+            continue;
+
+        auto away = playerCentricAwayUntil.find(botId);
+        if (away != playerCentricAwayUntil.end())
+        {
+            // Out of the zone on a visit elsewhere: nothing moves it until its return time.
+            if (now < away->second)
+                continue;
+
+            if (PlaceBotInPlayerZone(bot, target, now))
+                ++actions;
+
+            continue;
+        }
+
+        if (IsBotInPlayerZone(bot, target))
+        {
+            // Zone traffic: once a bot has been in the zone for its whole visit, it leaves for a
+            // while and something else (or itself, later) takes its place. The bot is only sent
+            // away when the player is too far from it to watch it disappear.
+            if (!sPlayerbotAIConfig.RandomBotNearPlayersZoneTraffic || now < playerCentricLeaveAt[botId] ||
+                bot->GetDistance(target) < PLAYER_CENTRIC_UNSEEN_DISTANCE)
+                continue;
+
+            if (SendBotAwayFromPlayerZone(bot, target, now))
+                ++actions;
+
+            continue;
+        }
+
+        // Drifted out of the zone (wandered, died nearby, was re-levelled): bring it back.
+        if (PlaceBotInPlayerZone(bot, target, now))
+            ++actions;
+    }
+}
