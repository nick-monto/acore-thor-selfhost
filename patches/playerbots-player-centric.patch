+// A real player is a valid player-centric anchor when it is online in the open world, awake, and
+// not in an instance, battleground, arena or on a transport. Bots never anchor to GMs.
+bool RandomPlayerbotMgr::IsPlayerCentricTargetValid(Player* player, Player* bot)
+{
+    if (!player || !bot || !player->IsInWorld() || player->IsGameMaster() || player->isDead())
+        return false;
+
+    // Only real players anchor bots; self-bots and other playerbot-driven characters do not.
+    if (GET_PLAYERBOT_AI(player))
+        return false;
+
+    if (player->IsBeingTeleported() || player->IsInFlight() || player->IsFlying() || player->InBattleground() ||
+        player->InArena() || player->IsInWater())
+        return false;
+
+    if (player->GetTransport())
+        return false;
+
+    Map* map = player->GetMap();
+    if (!map || map->Instanceable())
+        return false;
+
+    if (std::find(sPlayerbotAIConfig.RandomBotMaps.begin(), sPlayerbotAIConfig.RandomBotMaps.end(), map->GetId()) ==
+        sPlayerbotAIConfig.RandomBotMaps.end())
+        return false;
+
+    if (sPlayerbotAIConfig.RandomBotNearPlayersSameFaction && player->GetTeamId() != bot->GetTeamId())
+        return false;
+
+    // A Death Knight cannot be placed within the requested range of a low-level player, so leave
+    // that bot on the normal distribution instead of creating an out-of-range level 55 bot.
+    if (bot->getClass() == CLASS_DEATH_KNIGHT)
+    {
+        uint8 dkMinLevel = sWorld->getIntConfig(CONFIG_START_HEROIC_PLAYER_LEVEL);
+        if (player->GetLevel() + sPlayerbotAIConfig.RandomBotNearPlayersLevelRange < dkMinLevel)
+            return false;
+    }
+
+    return true;
+}
+
+// Player-centric movement is only safe for ungrouped, living bots that are not busy in an
+// instance, battleground, flight or combat. Grouped bots are left alone so a teleport cannot
+// split a group.
+bool RandomPlayerbotMgr::IsPlayerCentricBotEligible(Player* bot)
+{
+    if (!sPlayerbotAIConfig.RandomBotNearPlayers || !bot || !bot->IsInWorld())
+        return false;
+
+    if (!IsRandomBot(bot) || bot->isDead() || bot->IsInCombat() || bot->IsBeingTeleported() || bot->IsRooted() ||
+        bot->IsInFlight() || bot->IsFlying())
+        return false;
+
+    if (bot->InBattleground() || bot->InArena() || bot->inRandomLfgDungeon() || bot->InBattlegroundQueue())
+        return false;
+
+    Map* map = bot->GetMap();
+    if (!map || map->Instanceable())
+        return false;
+
+    if (bot->GetGroup())
+        return false;
+
+    PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot);
+    if (!botAI || botAI->GetMaster())
+        return false;
+
+    return true;
+}
+
+// Returns the bot's assigned player, assigning the least-loaded eligible player when there is no
+// valid assignment yet. Returns nullptr when no eligible player is online, letting the caller fall
+// back to the normal randombot behaviour.
+Player* RandomPlayerbotMgr::GetPlayerCentricTarget(Player* bot)
+{
+    if (!sPlayerbotAIConfig.RandomBotNearPlayers || !bot || players.empty())
+        return nullptr;
+
+    uint32 botId = bot->GetGUID().GetCounter();
+    auto assigned = playerCentricTargets.find(botId);
+    if (assigned != playerCentricTargets.end())
+    {
+        Player* target = ObjectAccessor::FindConnectedPlayer(assigned->second);
+        if (IsPlayerCentricTargetValid(target, bot))
+            return target;
+
+        playerCentricTargets.erase(assigned);
+        playerCentricFollowAt.erase(botId);
+        playerCentricInnerBots.erase(botId);
+        playerCentricZoneBots.erase(botId);
+    }
+
+    std::unordered_map<uint32, uint32> assignments;
+    std::unordered_map<uint32, uint32> innerAssignments;
+    std::unordered_map<uint32, uint32> zoneAssignments;
+    for (auto const& [assignedBotId, targetGuid] : playerCentricTargets)
+    {
+        if (!GetPlayerBot(ObjectGuid::Create<HighGuid::Player>(assignedBotId)))
+            continue;
+
+        assignments[targetGuid.GetCounter()]++;
+        if (playerCentricInnerBots.find(assignedBotId) != playerCentricInnerBots.end())
+            innerAssignments[targetGuid.GetCounter()]++;
+        if (playerCentricZoneBots.find(assignedBotId) != playerCentricZoneBots.end())
+            zoneAssignments[targetGuid.GetCounter()]++;
+    }
+
+    Player* best = nullptr;
+    uint32 bestCount = ~0u;
+    for (Player* player : players)
+    {
+        if (!IsPlayerCentricTargetValid(player, bot))
+            continue;
+
+        uint32 count = assignments[player->GetGUID().GetCounter()];
+        if (sPlayerbotAIConfig.RandomBotNearPlayersMaxPerPlayer > 0 &&
+            count >= sPlayerbotAIConfig.RandomBotNearPlayersMaxPerPlayer)
+            continue;
+
+        // Reservoir-sample ties so bots spread evenly over equally loaded players.
+        if (count < bestCount || (count == bestCount && urand(0, 1) == 0))
+        {
+            best = player;
+            bestCount = count;
+        }
+    }
+
+    if (!best)
+        return nullptr;
+
+    uint32 bestId = best->GetGUID().GetCounter();
+    playerCentricInnerBots.erase(botId);
+    playerCentricZoneBots.erase(botId);
+    if (innerAssignments[bestId] < sPlayerbotAIConfig.RandomBotNearPlayersInnerCount)
+        playerCentricInnerBots.insert(botId);
+    else if (zoneAssignments[bestId] < sPlayerbotAIConfig.RandomBotNearPlayersZoneCount)
+        playerCentricZoneBots.insert(botId);
+
+    playerCentricTargets[botId] = best->GetGUID();
+    return best;
+}
+
+bool RandomPlayerbotMgr::IsPlayerCentricInnerBot(Player* bot)
+{
+    return bot && playerCentricInnerBots.find(bot->GetGUID().GetCounter()) != playerCentricInnerBots.end();
+}
+
+bool RandomPlayerbotMgr::IsPlayerCentricZoneBot(Player* bot)
+{
+    return bot && playerCentricZoneBots.find(bot->GetGUID().GetCounter()) != playerCentricZoneBots.end();
+}
+
+void RandomPlayerbotMgr::GetPlayerCentricLevelBounds(Player* bot, Player* target, uint8& low, uint8& high)
+{
+    uint32 range = sPlayerbotAIConfig.RandomBotNearPlayersLevelRange;
+    uint32 targetLevel = target->GetLevel();
+    uint32 minLevel = sPlayerbotAIConfig.RandomBotMinLevel;
+    uint32 maxLevel = sPlayerbotAIConfig.RandomBotMaxLevel;
+
+    low = static_cast<uint8>(std::max(minLevel, targetLevel > range ? targetLevel - range : 1));
+    high = static_cast<uint8>(std::min(maxLevel, targetLevel + range));
+
+    if (bot && bot->getClass() == CLASS_DEATH_KNIGHT)
+    {
+        uint8 dkMinLevel = sWorld->getIntConfig(CONFIG_START_HEROIC_PLAYER_LEVEL);
+        low = std::max(low, dkMinLevel);
+        high = std::max(high, low);
+    }
+
+    if (low > high)
+    {
+        low = high = static_cast<uint8>(std::min(maxLevel, std::max(minLevel, targetLevel)));
+    }
+}
+
+bool RandomPlayerbotMgr::AdjustBotLevel(Player* bot, uint8 level)
+{
+    if (!bot || level == 0 || level == bot->GetLevel())
+        return false;
+
+    if (bot->IsMounted())
+        bot->Dismount();
+
+    PlayerbotFactory factory(bot, level);
+    factory.Randomize(false);
+    SetValue(bot, "level", level);
+    return true;
+}
+
+bool RandomPlayerbotMgr::TeleportBotNearPlayer(Player* bot, Player* target)
+{
+    if (!bot || !target || !bot->IsInWorld() || !target->IsInWorld())
+        return false;
+
+    if (bot->IsBeingTeleported() || target->IsBeingTeleported() || bot->IsInCombat() || bot->IsRooted() ||
+        bot->isDead() || bot->InBattleground() || bot->InArena() || bot->InBattlegroundQueue() || bot->GetGroup())
+        return false;
+
+    Map* map = target->GetMap();
+    if (!map || map->Instanceable())
+        return false;
+
+    bool inner = IsPlayerCentricInnerBot(bot);
+    float innerRadius = sPlayerbotAIConfig.RandomBotNearPlayersRadius;
+    float outerRadius = sPlayerbotAIConfig.RandomBotNearPlayersOuterRadius;
+    // The outer band starts inside the inner boundary, so outer bots can naturally wander into
+    // the inner area instead of being confined to a hard second ring.
+    float minDistance = inner ? innerRadius * 0.35f : innerRadius * 0.75f;
+    float maxDistance = inner ? innerRadius : std::max(innerRadius, outerRadius);
+    for (uint32 attempt = 0; attempt < 10; ++attempt)
+    {
+        float angle = frand(0.0f, static_cast<float>(2.0 * M_PI));
+        float distance = frand(minDistance, maxDistance);
+        float x = target->GetPositionX() + cosf(angle) * distance;
+        float y = target->GetPositionY() + sinf(angle) * distance;
+        float z = target->GetPositionZ();
+
+        if (!map->CanReachPositionAndGetValidCoords(target, x, y, z, true, true))
+            continue;
+
+        if (map->IsInWater(bot->GetPhaseMask(), x, y, z, bot->GetCollisionHeight()))
+            continue;
+
+        bot->GetMotionMaster()->Clear();
+        if (PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot))
+            botAI->Reset(true);
+
+        bot->RemoveAurasWithInterruptFlags(AURA_INTERRUPT_FLAG_TELEPORTED | AURA_INTERRUPT_FLAG_CHANGE_MAP);
+        bot->TeleportTo(map->GetId(), x, y, z, target->GetOrientation());
+        bot->SendMovementFlagUpdate();
+        return true;
+    }
+
+    return false;
+}
+
+// Zone tier: keep the bot in the assigned player's current zone, but outside the local rings.
+// It uses the normal level-appropriate travel locations, filtered to the target map and zone, so
+// roads, hubs and quest areas across the zone can be populated instead of only the player's
+// immediate surroundings.
+bool RandomPlayerbotMgr::TeleportBotToTargetZone(Player* bot, Player* target)
+{
+    if (!bot || !target || !bot->IsInWorld() || !target->IsInWorld())
+        return false;
+
+    if (bot->IsBeingTeleported() || target->IsBeingTeleported() || bot->IsInCombat() || bot->IsRooted() ||
+        bot->isDead() || bot->InBattleground() || bot->InArena() || bot->InBattlegroundQueue() || bot->GetGroup())
+        return false;
+
+    Map* targetMap = target->GetMap();
+    if (!targetMap || targetMap->Instanceable())
+        return false;
+
+    uint32 targetZone = targetMap->GetZoneId(PHASEMASK_NORMAL, target->GetPositionX(), target->GetPositionY(),
+                                              target->GetPositionZ());
+    if (!targetZone)
+        return false;
+
+    AreaTableEntry const* zone = sAreaTableStore.LookupEntry(targetZone);
+    if (zone && ((zone->team == 4 && bot->GetTeamId() == TEAM_ALLIANCE) ||
+                 (zone->team == 2 && bot->GetTeamId() == TEAM_HORDE)))
+        return false;
+
+    std::vector<WorldLocation> locs = sTravelMgr.GetTeleportLocations(bot);
+    std::vector<WorldLocation> zoneLocs;
+    for (WorldLocation const& loc : locs)
+    {
+        if (loc.GetMapId() != targetMap->GetId())
+            continue;
+
+        if (sMapMgr->GetZoneId(PHASEMASK_NORMAL, loc) != targetZone)
+            continue;
+
+        // Zone bots are deliberately outside the local outer ring.
+        if (target->GetDistance(loc.GetPositionX(), loc.GetPositionY(), loc.GetPositionZ()) <
+            sPlayerbotAIConfig.RandomBotNearPlayersOuterRadius)
+            continue;
+
+        zoneLocs.push_back(loc);
+    }
+
+    if (zoneLocs.empty())
+        return false;
+
+    RandomTeleport(bot, zoneLocs, false);
+    return true;
+}
+
+// Periodic pass that keeps the online random bots level-appropriate for, and close to, the real
+// players. It is deliberately rate-limited: a handful of bots are processed per manager tick so a
+// large bot population cannot turn a player login into a spike.
+void RandomPlayerbotMgr::UpdatePlayerCentricBots()
+{
+    if (!sPlayerbotAIConfig.RandomBotNearPlayers || players.empty())
+        return;
+
+    uint32 now = static_cast<uint32>(time(nullptr));
+
+    for (auto it = playerCentricTargets.begin(); it != playerCentricTargets.end();)
+    {
+        Player* assignedBot = GetPlayerBot(ObjectGuid::Create<HighGuid::Player>(it->first));
+        if (!assignedBot || !IsPlayerCentricBotEligible(assignedBot))
+        {
+            playerCentricFollowAt.erase(it->first);
+            playerCentricInnerBots.erase(it->first);
+            playerCentricZoneBots.erase(it->first);
+            it = playerCentricTargets.erase(it);
+        }
+        else
+        {
+            ++it;
+        }
+    }
+
+    uint32 actions = 0;
+    uint32 maxActions = _isBotInitializing ? 2 : 5;
+    PlayerBotMap bots = GetAllBots();
+
+    for (auto const& [botGuid, bot] : bots)
+    {
+        if (actions >= maxActions)
+            break;
+
+        if (!IsPlayerCentricBotEligible(bot))
+            continue;
+
+        Player* target = GetPlayerCentricTarget(bot);
+        if (!target)
+            continue;
+
+        uint32 botId = botGuid.GetCounter();
+        uint8 low, high;
+        GetPlayerCentricLevelBounds(bot, target, low, high);
+
+        if (!sPlayerbotAIConfig.DisableRandomLevels && !sPlayerbotAIConfig.RandomBotFixedLevel &&
+            (bot->GetLevel() < low || bot->GetLevel() > high))
+        {
+            if (AdjustBotLevel(bot, static_cast<uint8>(urand(low, high))))
+                ++actions;
+
+            continue;
+        }
+
+        if (now < playerCentricFollowAt[botId])
+            continue;
+
+        bool zoneBot = IsPlayerCentricZoneBot(bot);
+        bool needsTeleport;
+        if (zoneBot)
+        {
+            Map* botMap = bot->GetMap();
+            Map* targetMap = target->GetMap();
+            uint32 targetZone = targetMap
+                                    ? targetMap->GetZoneId(PHASEMASK_NORMAL, target->GetPositionX(),
+                                                           target->GetPositionY(), target->GetPositionZ())
+                                    : 0;
+            needsTeleport = bot->GetMapId() != target->GetMapId() || !botMap || !targetZone ||
+                            botMap->GetZoneId(PHASEMASK_NORMAL, bot->GetPositionX(), bot->GetPositionY(),
+                                              bot->GetPositionZ()) != targetZone;
+        }
+        else
+        {
+            // Inner bots get a wider hysteresis so they can drift into the overlap without being
+            // snapped back; outer bots are pulled back only when they leave the outer band.
+            float leash = IsPlayerCentricInnerBot(bot)
+                              ? sPlayerbotAIConfig.RandomBotNearPlayersRadius * 2.0f
+                              : sPlayerbotAIConfig.RandomBotNearPlayersOuterRadius * 1.5f;
+            needsTeleport = bot->GetMapId() != target->GetMapId() || bot->GetDistance(target) > leash;
+        }
+        if (!needsTeleport)
+            continue;
+
+        bool teleported = zoneBot ? TeleportBotToTargetZone(bot, target) : TeleportBotNearPlayer(bot, target);
+        playerCentricFollowAt[botId] =
+            now + (teleported ? sPlayerbotAIConfig.RandomBotNearPlayersFollowInterval : 15);
+        ++actions;
+    }
+}
